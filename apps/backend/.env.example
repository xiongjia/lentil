# Backend environment configuration

# Server port
PORT=3990

# Enable API docs (Swagger) at /api/docs (default: true)
# API_DOCS_ENABLED=true

# Logging level: trace, debug, info, warn, error, fatal
LOG_LEVEL=info

# Log file path (default: <cwd>/logs/lentil.backend.log)
# LOG_FILENAME=./logs/lentil.backend.log

# Max size per log file: k, m, g (e.g., 5M)
LOG_MAX_SIZE=5M

# Number of log files to keep
LOG_MAX_FILES=10

# Log directory (default: logs)
# LOG_DIR=logs

# Enable colorized output for stdout (default: true)
# LOG_COLORIZE=true

# Enable file system logging (default: false)
LOG_ENABLE_FS_LOG=false

# Dashboard base URL path (e.g., "/dashboard/" or "/")
DASHBOARD_BASE_URL=/dashboard/

# Dashboard static files directory (relative or absolute path)
DASHBOARD_STATIC_DIR=../dashboard/dist

# Database type: "libsql" (default) or "postgresql"
DB_TYPE=libsql

# PID file directory (default: .local)
PID_DIR=.local

# Database name (SQLite file path or PG database name)
DB_NAME=.local/lentil.db

# PostgreSQL only
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=postgres
