{
  "name": "@lentil/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "nest start",
    "cli": "node -r ts-node/register src/cli/main.ts",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "test": "jest",
    "stop": "node -e \"const fs=require('fs');const p='.local/lentil.pid';if(!fs.existsSync(p)){console.log('No PID file found — server not running');process.exit(1)}process.kill(fs.readFileSync(p,'utf8').trim(),'SIGTERM')\"",
    "docker:build": "cd ../.. && docker build -t lentil-backend:latest -f apps/backend/Dockerfile ."
  },
  "dependencies": {
    "@lentil/db": "workspace:*",
    "@mikro-orm/core": "catalog:",
    "@nestjs/common": "catalog:",
    "@nestjs/config": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@nestjs/swagger": "catalog:",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "nest-commander": "3",
    "nestjs-pino": "4.6",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "pino-pretty": "^13.0.0",
    "pino-roll": "^4.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@jest/globals": "catalog:",
    "@lentil/config": "workspace:*",
    "@lentil/dashboard": "workspace:*",
    "@nestjs/cli": "catalog:",
    "@nestjs/schematics": "catalog:",
    "@nestjs/testing": "catalog:",
    "@types/express": "^5.0.0",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "jest": "catalog:",
    "ts-jest": "catalog:",
    "ts-node": "10",
    "tsx": "^4.21.0",
    "typescript": "catalog:"
  }
}
