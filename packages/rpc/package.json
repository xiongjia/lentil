{
  "name": "@lentil/rpc",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "dependencies": {
    "@orpc/contract": "catalog:",
    "@orpc/zod": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@lentil/config": "workspace:*",
    "eslint": "catalog:",
    "tsup": "catalog:"
  }
}
